---
import { getCollection } from 'astro:content';
import BlogLayout from '@m3-astro/theme/layouts/BlogLayout';
import { enabledItems, getSiteConfig } from '@m3-astro/theme/blog/config';
import Chip from '@m3-astro/theme/components/Chip';
import Icon from '@m3-astro/theme/components/Icon';

export async function getStaticPaths() {
  const config = await getSiteConfig();
  return enabledItems(config.locales).map(({ code }) => ({
    params: { locale: code },
    props: { locale: code },
  }));
}

const { locale } = Astro.props;
const config = await getSiteConfig();
const localeConfig = config.locales.find(({ code }) => code === locale);
if (!localeConfig) throw new Error(`Missing locale configuration for ${locale}`);
const labels = { ...config.labels, ...localeConfig.labels };
const stories = (await getCollection('stories'))
  .filter((story) => (config.blog.showDrafts || !story.data.draft) && story.data.locale === locale);
const categoryCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
stories.forEach(({ data }) => {
  categoryCounts.set(data.category, (categoryCounts.get(data.category) ?? 0) + 1);
  data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], locale));
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], locale));
---

<BlogLayout title={`${labels.topicsTitle} — ${config.name}`} description={labels.topicsDescription} lang={locale}>
  <header class="md-content-grid md-page-header">
    <Chip selected><Icon name="category" size={18} />{labels.topicsTitle}</Chip>
    <h1 class="md-display-medium mt-6 max-w-5xl text-balance">{labels.topicsTitle}</h1>
    <p class="md-body-large mt-5 max-w-2xl text-on-surface-variant">{labels.topicsDescription}</p>
  </header>

  <div class="md-content-grid md-page-body grid gap-12">
    <section aria-labelledby="categories-heading">
      <h2 id="categories-heading" class="md-headline-large">{labels.categoriesLabel}</h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {categories.map(([category, count], index) => (
          <a href={`/${locale}/stories/?topic=${encodeURIComponent(category)}`} class="md-state-layer group grid min-h-44 content-between rounded-xl bg-surface-container-low p-6 no-underline" data-accent={['violet', 'rose', 'ocean'][index % 3]}>
            <Icon name={['gesture', 'lightbulb', 'explore'][index % 3]} size={34} filled />
            <div>
              <h3 class="md-title-large group-hover:underline">{category}</h3>
              <p class="md-body-medium mt-1 text-on-surface-variant">{count} {labels.storiesShown}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="tags-heading">
      <h2 id="tags-heading" class="md-headline-large">{labels.tagsLabel}</h2>
      <div class="mt-7 flex flex-wrap gap-3">
        {tags.map(([tag, count]) => (
          <a href={`/${locale}/search/?q=${encodeURIComponent(tag)}`} class="md-state-layer md-label-large inline-flex min-h-11 items-center gap-2 rounded-full border border-outline px-4 no-underline">
            <span>{tag}</span>
            <span class="rounded-full bg-secondary-container px-2 py-0.5 text-on-secondary-container">{count}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BlogLayout>
