---
import type { DefaultLocale } from '../i18n/index';
import { DEFAULT_LOCALE_ROUTES } from '../i18n/index';
import AdaptiveLayout from '../layouts/AdaptiveLayout.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import ContentCard from '../components/ContentCard.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';

export interface Props {
  locale: DefaultLocale;
}

const { locale } = Astro.props;
const routes = DEFAULT_LOCALE_ROUTES;
const locales = [
  { code: 'en', label: 'English', href: routes.en },
  { code: 'zh-CN', label: '简体中文', href: routes['zh-CN'] },
  { code: 'zh-TW', label: '繁體中文', href: routes['zh-TW'] },
  { code: 'ja', label: '日本語', href: routes.ja },
