    newsletterBody: 'デザインシステムと編集の技術について、隔週でひとつのノートをお届けします。',
    newsletterAction: '購読する',
  },
} as const;

const c = copy[locale];
const navItems = [
  { label: c.nav[0], href: routes[locale], icon: 'home' },
  { label: c.nav[1], href: '/demos/', icon: 'view_cozy' },
  { label: c.nav[2], href: '#about', icon: 'info' },
];
const topLinks = [
  { label: c.top[0], href: '#latest' },
  { label: c.top[1], href: '/demos/' },
  { label: c.top[2], href: '#about' },
];
const cardImages = [
  'https://images.unsplash.com/photo-1528360983277-13d401cdc186?auto=format&fit=crop&w=1200&q=85',
  'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1200&q=85',
  'https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1200&q=85',
];
const demoLinks = ['/demos/text/', '/demos/photos/', '/demos/data/', '/demos/interactive/'];
const demoIcons = ['article', 'photo_library', 'table_chart', 'tab'];
---

<AdaptiveLayout
  title={c.title}
  description={c.description}
  brand="M3 Journal"
  homeHref={routes[locale]}
  {navItems}
  {topLinks}
  {locales}
  currentLocale={locale}
  lang={locale}
>
  <header class="md-content-grid md-page-header grid items-end gap-8 md:grid-cols-[1fr_auto]">
    <div><Chip selected><Icon name="auto_awesome" size={18} />{c.edition}</Chip><h1 class="md-display-large mt-6 max-w-5xl text-balance">{c.hero}</h1></div>
    <p class="md-body-large max-w-xl text-on-surface-variant">{c.intro}</p>
  </header>

  <section class="md-content-grid md-page-body">
    <a href="/demos/text/" class="group grid overflow-hidden rounded-xl bg-primary-container text-on-primary-container no-underline shadow-2 lg:grid-cols-[1.15fr_.85fr]">
      <div class="min-h-[22rem] overflow-hidden"><img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1800&q=88" alt="A quiet landscape framed by warm natural light" fetchpriority="high" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" /></div>
      <div class="flex flex-col justify-end p-7 md:p-10"><p class="md-label-large">{c.featureTag}</p><h2 class="md-headline-large mt-4 text-balance">{c.featureTitle}</h2><p class="md-body-large mt-4 opacity-80">{c.featureDescription}</p><span class="md-label-large mt-7 inline-flex items-center gap-2">{c.primary}<Icon name="arrow_forward" size={20} /></span></div>
    </a>
  </section>

  <section id="latest" class="bg-surface-container-low md-section">
    <div class="md-content-grid">
      <SectionHeader eyebrow={c.latestEyebrow} title={c.latestTitle} description={c.latestDescription} />
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {c.cards.map((card, index) => <ContentCard href={demoLinks[index]} eyebrow={card[0]} title={card[1]} description={card[2]} meta={card[3]} image={cardImages[index]} imageAlt="" />)}
      </div>
    </div>
  </section>

  <section class="md-content-grid md-section">
    <SectionHeader eyebrow={c.browse} title={c.browseTitle} description={c.browseDescription} />
    <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {c.demoLabels.map((label, index) => (
        <a href={demoLinks[index]} class="md-state-layer group flex min-h-40 flex-col justify-between rounded-xl bg-surface-container-high p-6 no-underline transition-[transform,border-radius] duration-300 hover:-translate-y-1 hover:rounded-lg">
          <Icon name={demoIcons[index]} size={34} filled class="text-primary" />
          <span class="md-title-large flex items-end justify-between gap-3">{label}<Icon name="arrow_outward" size={21} /></span>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="md-content-grid md-page-body">
    <div class="grid overflow-hidden rounded-xl bg-secondary-container text-on-secondary-container md:grid-cols-[1fr_auto]">
      <div class="p-8 md:p-14"><Icon name="mark_email_unread" size={42} filled /><h2 class="md-headline-medium mt-7 max-w-2xl">{c.newsletter}</h2><p class="md-body-large mt-4 max-w-xl opacity-80">{c.newsletterBody}</p></div>
      <div class="flex items-end bg-surface-container-high p-8 text-on-surface md:p-12"><Button href="mailto:hello@example.com" size="lg"><Icon slot="icon" name="mail" />{c.newsletterAction}</Button></div>
    </div>
  </section>
</AdaptiveLayout>
