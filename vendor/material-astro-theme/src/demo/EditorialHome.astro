    description: 'An editorial Material 3 Expressive showcase for Astro, with multilingual typography and reusable content patterns.',
    nav: ['Journal', 'Demos', 'About'],
    top: ['Latest', 'Patterns', 'The theme'],
    edition: 'The expressive edition',
    hero: 'Stories with shape, rhythm, and room to breathe.',
    intro: 'A multilingual editorial demo built with Astro, semantic Material roles, generous typography, and components that let content lead.',
