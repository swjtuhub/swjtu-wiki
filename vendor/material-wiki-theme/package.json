{
  "name": "@m3-astro/wiki-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "description": "A configuration-first Material 3 Expressive wiki theme for Astro.",
  "keywords": ["astro", "wiki", "documentation", "material-design", "material-3"],
  "exports": {
    ".": "./src/integration.js",
    "./integration": "./src/integration.js",
    "./config": "./src/config.ts",
    "./content": "./src/content.ts",
    "./markdown": "./src/markdown.js",
    "./styles.css": "./src/styles/theme.css",
    "./components/*": "./src/components/*.astro",
    "./layouts/*": "./src/layouts/*.astro"
  },
  "dependencies": {
    "@m3-astro/theme": "file:../material-astro-theme",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "tailwindcss": ">=4.0.0"
  }
}
