{
  "name": "@m3-astro/theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Material 3 Expressive theme, components, and adaptive layout for Astro and Tailwind CSS.",
  "keywords": ["astro", "tailwindcss", "material-design", "material-3", "astro-component"],
  "exports": {
    "./styles.css": "./src/styles/theme.css",
    "./components/*": "./src/components/*.astro",
    "./layouts/*": "./src/layouts/*.astro",
    "./i18n": "./src/i18n/index.ts",
    "./config": "./src/config/index.ts",
    "./markdown": "./src/markdown/index.js",
    "./blog": "./src/blog/integration.js",
    "./blog/config": "./src/blog/config.ts",
    "./blog/content": "./src/blog/content.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.0.7",
    "tailwindcss": "4.3.2",
    "typescript": "^5.9.3"
  }
}
